{
  "name": "PreSonus StudioLive Control",
  "version": "1.3.0",
  "slug": "presonus-studiolive",
  "description": "Control PreSonus StudioLive III mixers from Home Assistant",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "image": "ghcr.io/joellogan/{arch}-addon-presonus-studiolive",
  "startup": "application",
  "boot": "auto",
  "init": false,
  "ports": {
    "8099/tcp": 8099
  },
  "ports_description": {
    "8099/tcp": "Web interface and API"
  },
  "options": {
    "mixer_ip": "192.168.1.100",
    "mixer_port": 53000,
    "log_level": "info",
    "mqtt_enabled": true,
    "state_debounce_ms": 300,
    "channels": [
      {
        "id": "chan_1",
        "name": "Channel 1",
        "type": "LINE",
        "number": 1
      },
      {
        "id": "chan_2",
        "name": "Channel 2",
        "type": "LINE",
        "number": 2
      },
      {
        "id": "chan_3",
        "name": "Channel 3",
        "type": "LINE",
        "number": 3
      },
      {
        "id": "chan_4",
        "name": "Channel 4",
        "type": "LINE",
        "number": 4
      },
      {
        "id": "chan_5",
        "name": "Channel 5",
        "type": "LINE",
        "number": 5
      },
      {
        "id": "chan_6",
        "name": "Channel 6",
        "type": "LINE",
        "number": 6
      },
      {
        "id": "chan_7",
        "name": "Channel 7",
        "type": "LINE",
        "number": 7
      },
      {
        "id": "chan_8",
        "name": "Channel 8",
        "type": "LINE",
        "number": 8
      },
      {
        "id": "tv_ul",
        "name": "Upper-Left TV",
        "type": "LINE",
        "number": 9
      },
      {
        "id": "tv_ur",
        "name": "Upper-Right TV",
        "type": "LINE",
        "number": 11
      },
      {
        "id": "tv_dl",
        "name": "Lower-Left TV",
        "type": "LINE",
        "number": 13
      },
      {
        "id": "tv_dr",
        "name": "Lower-Right TV",
        "type": "LINE",
        "number": 15
      },
      {
        "id": "main_fl",
        "name": "Front-Left Speaker",
        "type": "AUX",
        "number": 1
      },
      {
        "id": "main_fr",
        "name": "Front-Right Speaker",
        "type": "AUX",
        "number": 2
      },
      {
        "id": "main_bl",
        "name": "Back-Left Speaker",
        "type": "AUX",
        "number": 3
      },
      {
        "id": "main_br",
        "name": "Back-Right Speaker",
        "type": "AUX",
        "number": 4
      },
      {
        "id": "main",
        "name": "Main Audio Output",
        "type": "MAIN",
        "number": 1
      }
    ]
  },
  "schema": {
    "mixer_ip": "str",
    "mixer_port": "int(1024,65535)?",
    "log_level": "list(debug|info|warn|error)?",
    "mqtt_enabled": "bool?",
    "state_debounce_ms": "int(50,5000)?",
    "channels": [
      {
        "id": "match(^[a-z0-9_]+$)",
        "name": "str",
        "type": "list(LINE|AUX|FX|MAIN|SUB|RETURN|FXRETURN|TALKBACK|DCA)",
        "number": "int(1,64)"
      }
    ]
  },
  "services": [
    "mqtt:want"
  ],
  "watchdog": "http://[HOST]:[PORT:8099]/health"
}
